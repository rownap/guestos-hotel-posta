# ============================================================
# GuestOS — variabili d'ambiente
# ============================================================
# In locale: copia questo file in .env.local
# In produzione: Vercel → Project Settings → Environment Variables
# Nessuna di queste chiavi deve finire nel repository.
# ============================================================

# --- Assistente AI "Bubbles" ------------------------------------------------
# Chiave da console.anthropic.com. Se manca, la chat risponde in "modalità base"
# con risposte a parole chiave: l'app funziona ma l'AI vera è spenta.
ANTHROPIC_API_KEY=

# --- Supabase ---------------------------------------------------------------
# URL del progetto, es. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Chiave pubblica (la stessa che sta in config.js). Usata dalle funzioni server
# per leggere i cataloghi pubblici.
SUPABASE_ANON_KEY=
# Chiave di servizio: scavalca la RLS. SOLO lato server, MAI nel browser.
# Serve al webhook Stripe per confermare le prenotazioni.
SUPABASE_SERVICE_ROLE_KEY=

# --- Pagamenti Stripe -------------------------------------------------------
# Chiave segreta: sk_test_... in prova, sk_live_... in produzione.
STRIPE_SECRET_KEY=
# Segreto del webhook: Stripe → Sviluppatori → Webhook → endpoint
# https://<dominio>/api/stripe-webhook, evento checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# --- Email di conferma ------------------------------------------------------
# Chiave Resend (resend.com). Se manca, l'app NON si rompe: le email
# semplicemente non partono e la prenotazione resta valida.
RESEND_API_KEY=
# Mittente verificato sul dominio della struttura, es. "Hotel Posta <no-reply@hotelposta.it>"
MAIL_FROM=
# Facoltativo: copia nascosta allo staff per ogni conferma inviata.
MAIL_BCC_STAFF=

# --- Generali ---------------------------------------------------------------
# URL pubblico dell'app senza slash finale, es. https://guestos.it
# Serve a Stripe per costruire i link di ritorno dopo il pagamento.
PUBLIC_BASE_URL=
